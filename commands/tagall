module.exports = {
    name: 'tagall',
    aliases: ['tous', 'everyone', 'all'],
    description: 'Mentionne tous les membres du groupe',
    async execute(sock, msg, botState, ctx) {
        console.log('📢 [TAGALL] Commande reçue');

        // Vérifie qu'on est bien dans un groupe
        if (!ctx.isGroup) {
            await sock.sendMessage(ctx.from, {
                text: '❌ Cette commande fonctionne uniquement dans un groupe.'
            }, { quoted: msg });
            return;
        }

        // Message personnalisé optionnel
        const customMessage = ctx.args.join(' ').trim();

        try {
            // Récupère les métadonnées du groupe
            const groupMetadata = await sock.groupMetadata(ctx.from);
            const participants = groupMetadata.participants;

            if (!participants || participants.length === 0) {
                await sock.sendMessage(ctx.from, {
                    text: '❌ Impossible de récupérer les membres du groupe.'
                }, { quoted: msg });
                return;
            }

            // Filtre les participants : retire ceux qui ne sont plus dans le groupe
            const activeParticipants = participants.filter(p => {
                const jid = p.id || p.jid;
                return jid && !jid.includes('@lid');
            });

            // Construit la liste des mentions
            const mentions = activeParticipants.map(p => p.id || p.jid);

            // Construit le texte avec les mentions
            let text = customMessage ? `📢 ${customMessage}\n\n` : '📢 Attention à tous !\n\n';
            
            for (const participant of activeParticipants) {
                text += `@${(participant.id || participant.jid).split('@')[0]}\n`;
            }

            console.log(`📢 [TAGALL] ${activeParticipants.length} membres mentionnés`);

            await sock.sendMessage(ctx.from, {
                text: text.trim(),
                mentions: mentions
            }, { quoted: msg });

            console.log('✅ [TAGALL] Envoyé');

        } catch (e) {
            console.error('❌ Erreur tagall:', e.message);
            await sock.sendMessage(ctx.from, {
                text: `❌ Erreur: ${e.message}`
            }, { quoted: msg });
        }
    }
};
